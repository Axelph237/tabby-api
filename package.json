{
	"name": "elysia",
	"version": "1.0.50",
	"scripts": {
		"test": "bun --env-file=./src/__tests__/test.env test --preload __tests__/test.setup.ts",
		"dev": "bun run --watch src/index.ts",
		"build": "bun build ./src/index.ts --target=bun",
		"schema:push": "npx drizzle-kit push",
		"schema:migrate": "npx drizzle-kit generate && npx drizzle-kit migrate"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.2.0",
		"@elysiajs/jwt": "^1.2.0",
		"arctic": "^3.6.0",
		"bun": "^1.2.7",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.43.1",
		"drizzle-typebox": "^0.3.3",
		"elysia": "latest",
		"elysia-oauth2": "^2.0.0",
		"logixlysia": "^4.1.2",
		"prettier": "^3.5.3"
	},
	"devDependencies": {
		"@types/bun": "^1.2.14",
		"bun-types": "latest",
		"drizzle-kit": "^0.31.1"
	},
	"module": "src/index.js"
}
